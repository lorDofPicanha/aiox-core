{
  "name": "@synkra/contador-trilha-verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone hash-chain verifier for Contador good-faith ledger.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "contador-trilha-verify": "dist/cli.js",
    "contador-closeout-manifest": "dist/closeout-cli.js"
