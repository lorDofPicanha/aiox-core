{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Anipis Brand v2 — Aurora Coral. Multi-theme (Warm default + Calm + Soft). W3C DTCG-compatible. Source of truth equivalent to DESIGN.md frontmatter.",
  "anipis": {
    "$description": "Anipis design tokens root namespace",
    "version": {
      "$value": "2.0.0",
      "$type": "string"
    },

    "themes": {
      "$description": "Three opt-in themes — Warm is default, Calm + Soft are alternatives selectable in /settings/appearance",

      "warm": {
        "$description": "Aurora Coral — DEFAULT theme. Warm, terreno, brasileiro.",
        "color": {
          "primary": {
            "50":  { "$value": "#FFF1E8", "$type": "color" },
            "100": { "$value": "#FFDCBF", "$type": "color" },
            "300": { "$value": "#FF9A5C", "$type": "color" },
            "500": { "$value": "#DC6B3A", "$type": "color", "$description": "Brand primary — CTAs, links, user chat bubble" },
            "700": { "$value": "#9F4221", "$type": "color", "$description": "Hover, headings ênfase, AA contrast com white" }
          },
          "secondary": {
            "100": { "$value": "#D9EDE3", "$type": "color" },
            "300": { "$value": "#8EC5A9", "$type": "color" },
            "500": { "$value": "#4A9672", "$type": "color", "$description": "Sage Green — secondary buttons, progress" },
            "700": { "$value": "#2D6B4D", "$type": "color" }
          },
          "accent": {
            "100": { "$value": "#FFF3D6", "$type": "color" },
            "500": { "$value": "#E6AE2C", "$type": "color", "$description": "Luz Gold — badges, ornaments" }
          },
          "neutral": {
            "50":  { "$value": "#FAFAF8", "$type": "color" },
            "200": { "$value": "#E8E6E1", "$type": "color" },
            "500": { "$value": "#78746C", "$type": "color" },
            "800": { "$value": "#2A2823", "$type": "color" },
            "900": { "$value": "#1A1916", "$type": "color" }
          },
          "surface": {
            "page":     { "$value": "{anipis.themes.warm.color.neutral.50}",  "$type": "color" },
            "elevated": { "$value": "#FFFFFF", "$type": "color" },
            "overlay":  { "$value": "rgba(26, 25, 22, 0.5)", "$type": "color" }
          },
          "text": {
            "primary":   { "$value": "{anipis.themes.warm.color.neutral.800}", "$type": "color" },
            "secondary": { "$value": "{anipis.themes.warm.color.neutral.500}", "$type": "color" },
            "muted":     { "$value": "#A8A49C", "$type": "color" }
          },
          "border": {
            "default": { "$value": "{anipis.themes.warm.color.neutral.200}", "$type": "color" },
            "strong":  { "$value": "#D4D1CA", "$type": "color" }
          },
          "chat-bubble": {
            "user-bg":   { "$value": "{anipis.themes.warm.color.primary.500}", "$type": "color" },
            "user-text": { "$value": "#FFFFFF", "$type": "color" },
            "ai-bg":     { "$value": "{anipis.themes.warm.color.primary.50}",  "$type": "color" },
            "ai-text":   { "$value": "{anipis.themes.warm.color.neutral.800}", "$type": "color" },
            "ai-border": { "$value": "{anipis.themes.warm.color.primary.100}", "$type": "color" }
          }
        }
      },

      "calm": {
        "$description": "Sage Forest — opt-in alternative. Sereno, natural, fresco. Para uso noturno e usuários sensíveis a tons quentes.",
        "color": {
          "primary": {
            "50":  { "$value": "#EFF6F2", "$type": "color" },
            "100": { "$value": "#D1E8DC", "$type": "color" },
            "300": { "$value": "#7FB89B", "$type": "color" },
            "500": { "$value": "#4A9672", "$type": "color" },
            "700": { "$value": "#2D6B4D", "$type": "color" }
          },
          "secondary": {
            "100": { "$value": "#FFDCBF", "$type": "color" },
            "300": { "$value": "#FF9A5C", "$type": "color" },
            "500": { "$value": "#DC6B3A", "$type": "color" }
          },
          "accent": {
            "100": { "$value": "#D6EFF2", "$type": "color" },
            "500": { "$value": "#5BA8B8", "$type": "color" }
          },
          "neutral": {
            "50":  { "$value": "#F7F9F8", "$type": "color" },
            "200": { "$value": "#E0E4E2", "$type": "color" },
            "500": { "$value": "#6B736E", "$type": "color" },
            "800": { "$value": "#252925", "$type": "color" },
            "900": { "$value": "#161816", "$type": "color" }
          }
        }
      },

      "soft": {
        "$description": "Lavender Mist — opt-in alternative. Etéreo, dreamy, gentil. Para insônia, fragilidade, momentos de noite ruim.",
        "color": {
          "primary": {
            "50":  { "$value": "#F3EFF7", "$type": "color" },
            "100": { "$value": "#DCD3E8", "$type": "color" },
            "300": { "$value": "#9E89C2", "$type": "color" },
            "500": { "$value": "#7159A0", "$type": "color" },
            "700": { "$value": "#4A3B6E", "$type": "color" }
          },
          "secondary": {
            "100": { "$value": "#F0DAE0", "$type": "color" },
            "500": { "$value": "#C47E8A", "$type": "color" }
          },
          "accent": {
            "500": { "$value": "#D4B88E", "$type": "color" }
          },
          "neutral": {
            "50":  { "$value": "#F8F6FA", "$type": "color" },
            "200": { "$value": "#E5E0EA", "$type": "color" },
            "500": { "$value": "#736B7A", "$type": "color" },
            "800": { "$value": "#2A252F", "$type": "color" },
            "900": { "$value": "#1A171F", "$type": "color" }
          }
        }
      }
    },

    "shared": {
      "$description": "Tokens shared across all themes — semantic, crisis, mood, typography, spacing, motion",

      "color": {
        "semantic": {
          "success":     { "$value": "#3D9A5F", "$type": "color" },
          "success-bg":  { "$value": "#E3F5EA", "$type": "color" },
          "warning":     { "$value": "#D4960C", "$type": "color" },
          "warning-bg":  { "$value": "#FFF8E6", "$type": "color" },
          "error":       { "$value": "#D44040", "$type": "color" },
          "error-bg":    { "$value": "#FDE8E8", "$type": "color" },
          "info":        { "$value": "#4A7FC7", "$type": "color" },
          "info-bg":     { "$value": "#E8F0FA", "$type": "color" }
        },
        "crisis": {
          "$description": "Crisis tokens NEVER share hex with mood tokens (F-11 rule)",
          "yellow":       { "$value": "#E8B233", "$type": "color", "$description": "Atenção — banner amarelo" },
          "yellow-bg":    { "$value": "#FFF4DC", "$type": "color" },
          "orange":       { "$value": "#E37B2E", "$type": "color", "$description": "Alerta — banner laranja" },
          "orange-bg":    { "$value": "#FFEAD3", "$type": "color" },
          "red":          { "$value": "#C72828", "$type": "color", "$description": "Urgência — banner vermelho" },
          "red-bg":       { "$value": "#FDE2E2", "$type": "color" },
          "red-strong":   { "$value": "#A11C1C", "$type": "color", "$description": "Urgência max — AAA pass com white text (8.4:1). Hover do CTA vermelho." }
        },
        "mood": {
          "$description": "Mood colors dessaturadas v2 — dignity rule (Don Norman). Luminosity linear 50%→83% para CVD ordering.",
          "1": { "$value": "#7A6B8A", "$type": "color", "$description": "Muito difícil" },
          "2": { "$value": "#8A8EB8", "$type": "color", "$description": "Difícil" },
          "3": { "$value": "#A0B0B8", "$type": "color", "$description": "Neutro" },
          "4": { "$value": "#B8C4A0", "$type": "color", "$description": "Bem" },
          "5": { "$value": "#D4C4A0", "$type": "color", "$description": "Muito bem" }
        }
      },

      "typography": {
        "fontFamilies": {
          "heading": { "$value": "General Sans, system-ui, -apple-system, Segoe UI, Roboto, sans-serif", "$type": "fontFamily" },
          "body":    { "$value": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",         "$type": "fontFamily" },
          "quote":   { "$value": "Fraunces, Georgia, Times New Roman, serif",                             "$type": "fontFamily" },
          "mono":    { "$value": "JetBrains Mono, ui-monospace, SF Mono, Consolas, monospace",            "$type": "fontFamily" }
        },
        "fontWeights": {
          "normal":   { "$value": 400, "$type": "fontWeight" },
          "medium":   { "$value": 500, "$type": "fontWeight" },
          "semibold": { "$value": 600, "$type": "fontWeight" },
          "bold":     { "$value": 700, "$type": "fontWeight" }
        },
        "styles": {
          "display-xl": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "56px",
              "fontWeight": 700,
              "lineHeight": 1.15,
              "letterSpacing": "-0.02em"
            }
          },
          "display-md": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "40px",
              "fontWeight": 700,
              "lineHeight": 1.15,
              "letterSpacing": "-0.02em"
            }
          },
          "h1": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "40px",
              "fontWeight": 700,
              "lineHeight": 1.25,
              "letterSpacing": "-0.015em"
            }
          },
          "h2": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "32px",
              "fontWeight": 600,
              "lineHeight": 1.25,
              "letterSpacing": "-0.015em"
            }
          },
          "h3": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "24px",
              "fontWeight": 600,
              "lineHeight": 1.3,
              "letterSpacing": "-0.01em"
            }
          },
          "h4": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "20px",
              "fontWeight": 600,
              "lineHeight": 1.3,
              "letterSpacing": "-0.01em"
            }
          },
          "h5": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "16px",
              "fontWeight": 600,
              "lineHeight": 1.3,
              "letterSpacing": "-0.01em"
            }
          },
          "h6": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.heading}",
              "fontSize": "14px",
              "fontWeight": 600,
              "lineHeight": 1.3,
              "letterSpacing": "0"
            }
          },
          "body-lg": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.body}",
              "fontSize": "20px",
              "fontWeight": 400,
              "lineHeight": 1.65,
              "letterSpacing": "0"
            }
          },
          "body-md": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.body}",
              "fontSize": "18px",
              "fontWeight": 400,
              "lineHeight": 1.7,
              "letterSpacing": "0"
            }
          },
          "body-sm": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.body}",
              "fontSize": "14px",
              "fontWeight": 400,
              "lineHeight": 1.5,
              "letterSpacing": "0"
            }
          },
          "caption": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.body}",
              "fontSize": "12px",
              "fontWeight": 400,
              "lineHeight": 1.5,
              "letterSpacing": "0.005em"
            }
          },
          "overline": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.body}",
              "fontSize": "11px",
              "fontWeight": 500,
              "lineHeight": 1,
              "letterSpacing": "0.08em"
            }
          },
          "label-button": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.body}",
              "fontSize": "16px",
              "fontWeight": 500,
              "lineHeight": 1.2,
              "letterSpacing": "0.01em"
            }
          },
          "pullquote": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.quote}",
              "fontSize": "28px",
              "fontWeight": 400,
              "lineHeight": 1.4,
              "letterSpacing": "0",
              "fontStyle": "italic",
              "fontFeatureSettings": "'ital' 1"
            },
            "$description": "Fraunces Italic — reservado para voz pessoal do Anipis. Uso 5-10% das telas."
          },
          "code-md": {
            "$type": "typography",
            "$value": {
              "fontFamily": "{anipis.shared.typography.fontFamilies.mono}",
              "fontSize": "14px",
              "fontWeight": 400,
              "lineHeight": 1.55,
              "letterSpacing": "0"
            }
          }
        }
      },

      "spacing": {
        "$description": "8px base scale + 4px half-step",
        "1":  { "$value": "0.25rem", "$type": "dimension" },
        "2":  { "$value": "0.5rem",  "$type": "dimension" },
        "3":  { "$value": "0.75rem", "$type": "dimension" },
        "4":  { "$value": "1rem",    "$type": "dimension" },
        "5":  { "$value": "1.25rem", "$type": "dimension" },
        "6":  { "$value": "1.5rem",  "$type": "dimension" },
        "8":  { "$value": "2rem",    "$type": "dimension" },
        "12": { "$value": "3rem",    "$type": "dimension" },
        "16": { "$value": "4rem",    "$type": "dimension" },
        "container-narrow":  { "$value": "480px",  "$type": "dimension" },
        "container-default": { "$value": "720px",  "$type": "dimension" },
        "container-wide":    { "$value": "1080px", "$type": "dimension" }
      },

      "radius": {
        "$description": "Border radius scale — 4 values (Rams reduction v1 8 → v2 4)",
        "xs":     { "$value": "4px",    "$type": "dimension" },
        "sm":     { "$value": "8px",    "$type": "dimension", "$description": "buttons, inputs" },
        "md":     { "$value": "16px",   "$type": "dimension", "$description": "cards" },
        "bubble": { "$value": "20px",   "$type": "dimension", "$description": "chat bubbles signature" },
        "full":   { "$value": "9999px", "$type": "dimension", "$description": "pills, avatars" }
      },

      "shadow": {
        "soft":     { "$value": "0 2px 12px rgba(42, 40, 35, 0.06)",  "$type": "shadow" },
        "elevated": { "$value": "0 8px 32px rgba(42, 40, 35, 0.12)",  "$type": "shadow" },
        "soft-dark":     { "$value": "0 2px 12px rgba(0, 0, 0, 0.3)", "$type": "shadow" },
        "elevated-dark": { "$value": "0 8px 32px rgba(0, 0, 0, 0.5)", "$type": "shadow" }
      },

      "touchTarget": {
        "min":    { "$value": "44px", "$type": "dimension", "$description": "WCAG minimum" },
        "crisis": { "$value": "48px", "$type": "dimension", "$description": "Crisis CTAs — extra margin, vida em jogo" }
      },

      "motion": {
        "$description": "6 motion tokens — breath é signature (8s = 6 ciclos/min = respiração relaxada humana)",
        "breath":    { "$value": { "duration": "8000ms", "easing": "cubic-bezier(0.45, 0, 0.15, 1)" },     "$type": "transition", "$description": "Signature ambient — orb, background, logo D3" },
        "arrive":    { "$value": { "duration": "400ms",  "easing": "cubic-bezier(0, 0.5, 0.3, 1)" },       "$type": "transition", "$description": "Element entering — slow at end, gentle rest" },
        "depart":    { "$value": { "duration": "300ms",  "easing": "cubic-bezier(0.5, 0, 1, 0.5)" },       "$type": "transition", "$description": "Element leaving — clean exit" },
        "settle":    { "$value": { "duration": "400ms",  "easing": "cubic-bezier(0.45, 0, 0.15, 1)" },     "$type": "transition", "$description": "State change in-out" },
        "heartbeat": { "$value": { "duration": "200ms",  "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)" }, "$type": "transition", "$description": "Micro-feedback subtle spring" },
        "pulse":     { "$value": { "duration": "1800ms", "easing": "cubic-bezier(0.4, 0, 0.6, 1)" },       "$type": "transition", "$description": "Typing indicator dots" }
      },

      "stagger": {
        "fast": { "$value": "80ms",  "$type": "duration" },
        "slow": { "$value": "150ms", "$type": "duration" }
      },

      "zIndex": {
        "base":     { "$value": 1,   "$type": "number" },
        "dropdown": { "$value": 100, "$type": "number" },
        "sticky":   { "$value": 200, "$type": "number" },
        "modal":    { "$value": 300, "$type": "number" },
        "toast":    { "$value": 400, "$type": "number" },
        "crisis":   { "$value": 500, "$type": "number", "$description": "Crisis banners always on top" }
      }
    },

    "components": {
      "$description": "Component-level tokens — reference theme + shared tokens",

      "button-primary": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.primary.500}", "$type": "color" },
        "textColor":       { "$value": "#FFFFFF", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.full}", "$type": "dimension" },
        "padding":         { "$value": "{anipis.shared.spacing.4}",   "$type": "dimension" },
        "height":          { "$value": "48px", "$type": "dimension" },
        "typography":      { "$value": "{anipis.shared.typography.styles.label-button}", "$type": "typography" }
      },
      "button-primary-hover": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.primary.700}", "$type": "color" }
      },
      "button-secondary": {
        "backgroundColor": { "$value": "#FFFFFF", "$type": "color" },
        "textColor":       { "$value": "{anipis.themes.warm.color.primary.700}", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.full}", "$type": "dimension" },
        "padding":         { "$value": "{anipis.shared.spacing.4}",   "$type": "dimension" },
        "height":          { "$value": "48px", "$type": "dimension" }
      },
      "button-ghost": {
        "backgroundColor": { "$value": "transparent", "$type": "color" },
        "textColor":       { "$value": "{anipis.themes.warm.color.primary.700}", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.full}", "$type": "dimension" }
      },
      "button-crisis": {
        "backgroundColor": { "$value": "{anipis.shared.color.crisis.red-strong}", "$type": "color" },
        "textColor":       { "$value": "#FFFFFF", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.full}", "$type": "dimension" },
        "padding":         { "$value": "{anipis.shared.spacing.4}",   "$type": "dimension" },
        "height":          { "$value": "{anipis.shared.touchTarget.crisis}", "$type": "dimension" }
      },
      "card-content": {
        "backgroundColor": { "$value": "#FFFFFF", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.md}",  "$type": "dimension" },
        "padding":         { "$value": "{anipis.shared.spacing.6}",  "$type": "dimension" },
        "shadow":          { "$value": "{anipis.shared.shadow.soft}", "$type": "shadow" }
      },
      "chat-bubble-companion": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.chat-bubble.ai-bg}",     "$type": "color" },
        "textColor":       { "$value": "{anipis.themes.warm.color.chat-bubble.ai-text}",   "$type": "color" },
        "borderColor":     { "$value": "{anipis.themes.warm.color.chat-bubble.ai-border}", "$type": "color" },
        "rounded":         { "$value": "20px 20px 20px 4px", "$type": "string", "$description": "tail bottom-left" },
        "padding":         { "$value": "12px 16px", "$type": "string" },
        "typography":      { "$value": "{anipis.shared.typography.styles.body-md}", "$type": "typography" }
      },
      "chat-bubble-user": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.chat-bubble.user-bg}",   "$type": "color" },
        "textColor":       { "$value": "{anipis.themes.warm.color.chat-bubble.user-text}", "$type": "color" },
        "rounded":         { "$value": "20px 20px 4px 20px", "$type": "string", "$description": "tail bottom-right" },
        "padding":         { "$value": "12px 16px", "$type": "string" },
        "typography":      { "$value": "{anipis.shared.typography.styles.body-md}", "$type": "typography" }
      },
      "mood-checkin-card": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.surface.page}", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.md}", "$type": "dimension" },
        "padding":         { "$value": "{anipis.shared.spacing.8}", "$type": "dimension" }
      },
      "breathing-orb": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.primary.100}", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.full}",  "$type": "dimension" },
        "size":            { "$value": "200px", "$type": "dimension" },
        "animation":       { "$value": "{anipis.shared.motion.breath}", "$type": "transition" }
      },
      "onboarding-step": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.surface.page}", "$type": "color" },
        "padding":         { "$value": "{anipis.shared.spacing.8}", "$type": "dimension" }
      },
      "crisis-banner": {
        "backgroundColor": { "$value": "{anipis.shared.color.crisis.red-strong}", "$type": "color" },
        "textColor":       { "$value": "#FFFFFF", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.md}", "$type": "dimension" },
        "padding":         { "$value": "{anipis.shared.spacing.4}", "$type": "dimension" },
        "zIndex":          { "$value": "{anipis.shared.zIndex.crisis}", "$type": "number" }
      },
      "crisis-banner-warning": {
        "backgroundColor": { "$value": "{anipis.shared.color.crisis.yellow-bg}", "$type": "color" },
        "textColor":       { "$value": "{anipis.themes.warm.color.text.primary}", "$type": "color" },
        "borderColor":     { "$value": "{anipis.shared.color.crisis.orange}", "$type": "color" },
        "rounded":         { "$value": "{anipis.shared.radius.md}", "$type": "dimension" },
        "padding":         { "$value": "{anipis.shared.spacing.4}", "$type": "dimension" }
      },
      "input-field": {
        "backgroundColor": { "$value": "{anipis.themes.warm.color.neutral.50}", "$type": "color" },
        "textColor":       { "$value": "{anipis.themes.warm.color.text.primary}", "$type": "color" },
