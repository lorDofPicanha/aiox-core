<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>BRETDA — The Collection</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,400&family=Raleway:wght@200;300;400;500&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg:#2A2B26;
    --bg-2:#1F201C;
    --velvet:#161712;
    --accent:#C9A961;
    --accent-dim:rgba(201,169,97,.42);
    --head:#F2EFE8;
    --body:#B7B3A8;
    --hair:rgba(201,169,97,.28);
    --hair-soft:rgba(242,239,232,.10);
    --radius:4px;
    --max:1320px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg);color:var(--body);
    font-family:'Raleway',sans-serif;font-weight:300;line-height:1.6;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:hidden;
  }
  ::selection{background:var(--accent);color:var(--bg-2)}
  a{color:inherit;text-decoration:none}
  img{display:block;max-width:100%}

  /* ---------- Sticky bar ---------- */
  .topbar{
    position:fixed;top:0;left:0;right:0;z-index:50;
    display:flex;align-items:center;justify-content:space-between;
    padding:18px clamp(20px,5vw,64px);
    background:rgba(31,32,28,.72);
    backdrop-filter:blur(14px) saturate(120%);-webkit-backdrop-filter:blur(14px) saturate(120%);
    border-bottom:1px solid var(--hair-soft);
    transition:background .4s ease, border-color .4s ease;
  }
  .topbar.scrolled{background:rgba(31,32,28,.93);border-bottom-color:var(--hair)}
  .brand{font-family:'Bodoni Moda',serif;font-weight:500;font-size:20px;letter-spacing:.42em;color:var(--head);padding-left:.42em}
  .top-actions{display:flex;align-items:center;gap:clamp(14px,3vw,34px)}
  .geo{display:flex;align-items:center;gap:9px;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--body)}
  .geo .cur{color:var(--accent)}.geo .swap{opacity:.4}.geo .cur.alt{color:var(--body);opacity:.55}
  .inquire-top{
    display:inline-flex;align-items:center;gap:12px;min-height:44px;padding:0 22px;
    border:1px solid var(--hair);border-radius:var(--radius);
    font-size:11.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--head);
    transition:border-color .35s ease, background .35s ease, letter-spacing .35s ease;
  }
  .inquire-top:hover{border-color:var(--accent);background:rgba(201,169,97,.06);letter-spacing:.3em}
  .inquire-top .arrow{color:var(--accent);font-size:14px;transform:translateY(-1px)}

  /* ---------- Masthead ---------- */
  .masthead{max-width:var(--max);margin:0 auto;padding:clamp(140px,17vh,210px) clamp(20px,5vw,64px) clamp(40px,5vh,64px)}
  .eyebrow{font-size:11px;letter-spacing:.42em;text-transform:uppercase;color:var(--accent);margin-bottom:32px}
  .masthead h1{font-family:'Bodoni Moda',serif;font-weight:500;color:var(--head);
    font-size:clamp(56px,10.5vw,148px);line-height:.92;letter-spacing:-.01em;margin-bottom:36px}
  .masthead h1 em{font-style:italic;font-weight:400}
  .masthead .lede{max-width:620px;font-size:clamp(15px,1.5vw,18px);font-weight:300;line-height:1.75;color:var(--body)}
  .masthead .lede strong{color:var(--head);font-weight:400}

  /* ---------- Filter rail (sticky, working) ---------- */
  .filterwrap{position:sticky;top:73px;z-index:40;background:rgba(31,32,28,.86);
    backdrop-filter:blur(12px) saturate(120%);-webkit-backdrop-filter:blur(12px) saturate(120%);
    border-top:1px solid var(--hair-soft);border-bottom:1px solid var(--hair-soft)}
  .filter{max-width:var(--max);margin:0 auto;padding:15px clamp(20px,5vw,64px);
    display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .filter .flabel{font-size:10.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--body);opacity:.7;margin-right:6px}
  .chip{
    appearance:none;cursor:pointer;background:transparent;color:var(--body);
    border:1px solid var(--hair-soft);border-radius:40px;min-height:40px;padding:0 18px;
    font-family:'Raleway',sans-serif;font-weight:400;font-size:12px;letter-spacing:.12em;text-transform:uppercase;
    display:inline-flex;align-items:center;gap:9px;transition:all .3s ease;
  }
  .chip:hover{border-color:var(--hair);color:var(--head)}
  .chip .n{font-size:10.5px;opacity:.55;letter-spacing:.04em}
  .chip[aria-pressed="true"]{background:var(--accent);color:var(--bg-2);border-color:var(--accent)}
  .chip[aria-pressed="true"] .n{opacity:.7}
  .chip:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  /* ---------- Band ---------- */
  .band{padding:clamp(48px,7vh,96px) 0 clamp(20px,3vh,36px)}
  .band-inner{max-width:var(--max);margin:0 auto;padding:0 clamp(20px,5vw,64px)}
  .band-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;flex-wrap:wrap;margin-bottom:clamp(34px,5vh,60px)}
  .band-head .meta{font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:var(--accent);margin-bottom:18px}
  .band-title{font-family:'Bodoni Moda',serif;font-weight:500;color:var(--head);
    font-size:clamp(56px,10vw,150px);line-height:.86;letter-spacing:-.015em}
  .band-note{max-width:340px;text-align:right;font-size:13.5px;line-height:1.7;color:var(--body);padding-bottom:10px}
  .band-note .range{display:block;color:var(--accent);font-size:12px;letter-spacing:.16em;margin-top:10px}

  .divider{max-width:var(--max);margin:clamp(40px,6vh,80px) auto 0;padding:0 clamp(20px,5vw,64px)}
  .divider hr{border:0;height:1px;background:linear-gradient(90deg,transparent,var(--accent-dim) 18%,var(--accent-dim) 82%,transparent)}

  /* ---------- Grid of cards ---------- */
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(28px,3vw,52px)}
  .grid.wide{grid-template-columns:repeat(4,1fr);gap:clamp(24px,2.4vw,40px)}

  /* JEWEL ON VELVET card (preserved from v2) */
  .card{display:block;position:relative}
  .card .frame{
    position:relative;overflow:hidden;border-radius:var(--radius);aspect-ratio:4/3.05;
    background:
      radial-gradient(120% 90% at 50% 116%, rgba(201,169,97,.14), rgba(201,169,97,0) 52%),
      radial-gradient(140% 120% at 50% 38%, #20211c 0%, var(--velvet) 70%, #100f0c 100%);
    box-shadow:inset 0 0 90px 10px rgba(0,0,0,.55);
  }
  .card .frame::after{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:
      radial-gradient(130% 100% at 50% 0%, rgba(0,0,0,.42), transparent 46%),
      linear-gradient(180deg, rgba(22,23,18,0) 64%, rgba(22,23,18,.5) 100%);
    transition:opacity .5s ease;
  }
  .card img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:contain;
    padding:7% 8%;
    -webkit-mask-image:radial-gradient(120% 124% at 50% 50%, #000 60%, transparent 99%);
            mask-image:radial-gradient(120% 124% at 50% 50%, #000 60%, transparent 99%);
    transition:transform 1.1s cubic-bezier(.2,.7,.2,1), filter .6s ease;
    filter:saturate(1) contrast(1.03) brightness(1.02);
  }
  /* real installed photos read better filling the frame, lightly graded */
  .card.photo .frame{background:var(--velvet)}
  .card.photo img{object-fit:cover;padding:0;
    -webkit-mask-image:radial-gradient(135% 135% at 50% 46%, #000 72%, transparent 100%);
            mask-image:radial-gradient(135% 135% at 50% 46%, #000 72%, transparent 100%);
    filter:saturate(1.02) contrast(1.05) brightness(.92)}
  .card:hover img{transform:scale(1.035) translateY(-.6%);filter:saturate(1.05) contrast(1.06) brightness(1.05)}
  .card.photo:hover img{filter:saturate(1.05) contrast(1.06) brightness(.97)}

  .card .label{padding:22px 4px 0}
  .gem{font-family:'Bodoni Moda',serif;font-weight:500;color:var(--head);line-height:1.02;letter-spacing:-.005em;
    font-size:clamp(28px,2.6vw,38px)}
  .gem .alias{display:block;font-family:'Raleway';font-weight:300;font-size:11px;letter-spacing:.2em;
    text-transform:uppercase;color:var(--body);opacity:.55;margin-top:7px}
  .price{display:block;color:var(--accent);font-weight:400;font-size:13px;letter-spacing:.05em;margin-top:10px}
  .price .from{color:var(--body);font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;margin-right:8px}
  .price .ccy{color:var(--body);opacity:.6;font-size:10.5px;letter-spacing:.14em;margin-left:6px}
  .kind{display:block;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--body);opacity:.7;margin-top:11px}
  .seemore{display:inline-flex;align-items:center;gap:10px;margin-top:15px;min-height:24px;
    font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--head);
    border-bottom:1px solid transparent;transition:border-color .35s ease,gap .35s ease}
  .card:hover .seemore{border-bottom-color:var(--accent);gap:16px}
  .seemore .arrow{color:var(--accent);transform:translateY(-1px)}

  .tag{position:absolute;top:16px;left:16px;z-index:2;display:inline-flex;align-items:center;gap:8px;
    padding:7px 13px;border:1px solid var(--hair);border-radius:2px;background:rgba(20,21,18,.55);backdrop-filter:blur(6px);
    font-size:9px;letter-spacing:.26em;text-transform:uppercase;color:var(--accent)}

  /* empty state */
  .empty{display:none;max-width:var(--max);margin:0 auto;padding:60px clamp(20px,5vw,64px);
    text-align:center;color:var(--body)}
  .empty.show{display:block}

  /* hide a card filtered out */
  .card[hidden]{display:none}
  .band[data-empty="true"]{display:none}

  /* ---------- Commission prompt ---------- */
  .commission{max-width:var(--max);margin:clamp(50px,7vh,96px) auto 0;padding:0 clamp(20px,5vw,64px)}
  .commission .inner{border-top:1px solid var(--hair);padding-top:clamp(40px,6vh,72px);
    display:flex;align-items:flex-end;justify-content:space-between;gap:40px;flex-wrap:wrap}
  .commission h3{font-family:'Bodoni Moda',serif;font-weight:500;color:var(--head);
    font-size:clamp(34px,4.6vw,62px);line-height:1.02;letter-spacing:-.01em;max-width:680px}
  .commission h3 em{font-style:italic;font-weight:400;color:var(--accent)}
  .commission p{font-size:13.5px;color:var(--body);max-width:380px;margin-top:18px;line-height:1.7}
  .commission .cta-wrap{display:flex;flex-direction:column;gap:14px;align-items:flex-start;padding-bottom:6px}
  .btn-primary{display:inline-flex;align-items:center;gap:14px;min-height:52px;padding:0 32px;
    background:var(--accent);color:var(--bg-2);border-radius:var(--radius);
    font-size:12px;letter-spacing:.24em;text-transform:uppercase;font-weight:500;
    transition:transform .35s ease, box-shadow .35s ease, gap .35s ease}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 40px -18px rgba(201,169,97,.6);gap:18px}
  .btn-ghost{display:inline-flex;align-items:center;gap:10px;min-height:44px;
    font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--body);
    border-bottom:1px solid transparent;transition:color .3s ease,border-color .3s ease}
  .btn-ghost:hover{color:var(--head);border-bottom-color:var(--hair)}
  .btn-ghost .arrow{color:var(--accent)}

  /* ---------- Footer ---------- */
  footer{border-top:1px solid var(--hair-soft);margin-top:clamp(70px,10vh,150px);
    padding:clamp(54px,8vh,96px) clamp(20px,5vw,64px) clamp(40px,6vh,64px);background:var(--bg-2)}
  .foot-inner{max-width:var(--max);margin:0 auto;display:flex;justify-content:space-between;gap:50px;flex-wrap:wrap}
  .foot-brand{font-family:'Bodoni Moda',serif;font-weight:500;font-size:clamp(40px,6vw,84px);color:var(--head);line-height:.9;letter-spacing:-.01em}
  .foot-brand span{display:block;font-family:'Raleway';font-weight:300;font-size:12px;letter-spacing:.32em;text-transform:uppercase;color:var(--accent);margin-top:22px}
  .foot-meta{text-align:right;font-size:12px;line-height:1.9;color:var(--body);letter-spacing:.04em;max-width:360px}
  .foot-meta .made{color:var(--accent);letter-spacing:.18em;text-transform:uppercase;font-size:10.5px;display:block;margin-bottom:14px}
  .foot-legal{max-width:var(--max);margin:clamp(40px,6vh,70px) auto 0;padding-top:26px;border-top:1px solid var(--hair-soft);
    display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:rgba(183,179,168,.5)}

  /* reveal */
  .reveal{opacity:0;transform:translateY(22px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
  .reveal.in{opacity:1;transform:none}

  /* ---------- Responsive ---------- */
  @media (max-width:1080px){.grid,.grid.wide{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:900px){
    .band-note{text-align:left;max-width:none}
    .filterwrap{top:69px}
    .commission .inner{flex-direction:column;align-items:flex-start}
    .geo{display:none}
  }
  @media (max-width:640px){
    .grid,.grid.wide{grid-template-columns:1fr}
    .brand{font-size:16px;letter-spacing:.32em}
    .inquire-top{padding:0 14px;letter-spacing:.18em}
    .filter{gap:8px}
  }
  @media (prefers-reduced-motion:reduce){
    *{transition:none!important;animation:none!important}
    .reveal{opacity:1;transform:none}
    html{scroll-behavior:auto}
  }
</style>
</head>
<body>

<!-- ============ STICKY BAR ============ -->
<header class="topbar" id="topbar">
  <a href="home.html" class="brand">BRETDA</a>
  <nav class="top-actions">
    <span class="geo" title="Pricing shown in your local currency by region">
      <span class="cur">$&nbsp;USD</span><span class="swap">/</span><span class="cur alt">€&nbsp;EUR</span>
    </span>
    <a href="#inquire" class="inquire-top">Request a Quote <span class="arrow">&rarr;</span></a>
  </nav>
</header>

<!-- ============ MASTHEAD ============ -->
<main id="top">
<section class="masthead">
  <p class="eyebrow reveal">The Collection · Made to order · Brazil</p>
  <h1 class="reveal">Heirlooms<br>that <em>play.</em></h1>
  <p class="lede reveal">Thirty tables, cut and finished by hand in our atelier, then crated and shipped to homes across the United States and Europe. Billiards and snooker, ping-pong, foosball, shuffleboard and convertible dining — <strong>each one named for a Brazilian gemstone</strong>.</p>
</section>

<!-- ============ FILTER (working) ============ -->
<div class="filterwrap">
  <div class="filter" id="filter" role="group" aria-label="Filter the collection by game">
    <span class="flabel">Filter</span>
    <button class="chip" data-cat="all" aria-pressed="true">All <span class="n" data-count="all"></span></button>
    <button class="chip" data-cat="billiards" aria-pressed="false">Billiards &amp; Snooker <span class="n" data-count="billiards"></span></button>
    <button class="chip" data-cat="pingpong" aria-pressed="false">Ping-Pong <span class="n" data-count="pingpong"></span></button>
    <button class="chip" data-cat="foosball" aria-pressed="false">Foosball <span class="n" data-count="foosball"></span></button>
    <button class="chip" data-cat="shuffleboard" aria-pressed="false">Shuffleboard <span class="n" data-count="shuffleboard"></span></button>
    <button class="chip" data-cat="convertible" aria-pressed="false">Convertible · Dining <span class="n" data-count="convertible"></span></button>
  </div>
</div>

<!-- ============ BAND · ATELIER ============ -->
<section class="band" id="atelier" data-band="atelier">
  <div class="band-inner">
    <div class="band-head reveal">
      <div>
        <p class="meta">Band 01 — The rarest commissions</p>
        <h2 class="band-title">Atelier</h2>
      </div>
      <p class="band-note">Our most considered pieces — the largest spans, the rarest woods, the longest builds. Reserved slots only.
        <span class="range">From $16,000 to $24,000</span>
      </p>
    </div>
    <div class="grid" data-grid="atelier">
      <!-- cards injected -->
    </div>
  </div>

  <div class="commission reveal" id="inquire">
    <div class="inner">
      <div>
        <h3>Begin an <em>Atelier</em> commission.</h3>
        <p>A private conversation with the workshop. We'll walk you through woods, dimensions and your room — no obligation, no queue you can't leave.</p>
      </div>
      <div class="cta-wrap">
        <a href="#" class="btn-primary">Start your commission <span class="arrow">&rarr;</span></a>
        <a href="#" class="btn-ghost">Download the dossier (PDF) <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </div>
</section>

<div class="divider" data-divider><hr /></div>

<!-- ============ BAND · SIGNATURE ============ -->
<section class="band" id="signature" data-band="signature">
  <div class="band-inner">
    <div class="band-head reveal">
      <div>
        <p class="meta">Band 02 — The collection, ready to commission</p>
        <h2 class="band-title">Signature</h2>
      </div>
      <p class="band-note">The full range of our craft, in more games, sizes and finishes. Every piece is still cut and finished by the same hands.
        <span class="range">From $8,000 to $15,000</span>
      </p>
    </div>
    <div class="grid wide" data-grid="signature">
      <!-- cards injected -->
    </div>
  </div>

  <div class="commission reveal" id="inquire-2">
    <div class="inner">
      <div>
        <h3>Found the one? <em>Start your table.</em></h3>
        <p>Tell us the gemstone, your room and your timeline. Made to order means yours is built for you — and the calendar fills by the season.</p>
      </div>
      <div class="cta-wrap">
        <a href="#" class="btn-primary">Request a Quote <span class="arrow">&rarr;</span></a>
        <a href="#" class="btn-ghost">Book a private viewing <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </div>
</section>

<!-- empty state -->
<div class="empty" id="empty">
  <p class="gem" style="font-size:clamp(28px,3vw,40px)">Nothing in that game — yet.</p>
  <p style="margin-top:14px">Every table is made to order. Tell us the game you have in mind and we'll build it.</p>
</div>
</main>

<!-- ============ FOOTER ============ -->
<footer>
  <div class="foot-inner">
    <div class="foot-brand">BRETDA<span>Atelier of game tables</span></div>
    <div class="foot-meta">
      <span class="made">Made to order · Shipped worldwide</span>
      Crated and exported to the United States &amp; Europe.<br>
      Each commission carries the maker's mark and a certificate of origin.<br>
      Prices shown in $ / € by region.
    </div>
  </div>
  <div class="foot-legal">
    <span>© Bretda — All rights reserved</span>
    <span>Privacy · Terms · CNPJ on file</span>
  </div>
</footer>

<script>
/* ============================================================
   MODEL CATALOG — 30 tables across two bands.
   Names are the founder-approved canonical PRECIOUS-STONE map
   (docs/projects/bretda-website-v2/design/naming-map-gemas.md, 2026-06-24).
   img "fit:photo" = real installed photograph; default = studio render.
   ============================================================ */
var MODELS=[
  /* ---- ATELIER ---- */
  {name:"Turmalina Paraíba", band:"atelier", cat:"billiards", price:"24,000", kind:"Billiards · cantilever blade base", img:"assets-collection/t-aparato.jpg", fit:"photo", tag:"Flagship · the crown jewel", href:"#inquire"},
  {name:"Espinela", band:"atelier", cat:"billiards", price:"23,200", kind:"Billiards · underlit monolith base", img:"assets-collection/espinela.jpg", tag:"1 of 8 / yr", href:"#inquire"},
  {name:"Diamante", band:"atelier", cat:"billiards", price:"22,400", kind:"Billiards · mirror-steel cradle", img:"assets-collection/aurora.jpg", href:"pdp-aurora.html"},
  {name:"Água-marinha", band:"atelier", cat:"billiards", price:"21,000", kind:"Billiards · folded-wood prism base", img:"assets-collection/zurita.jpg", href:"#inquire"},
  {name:"Alexandrita", band:"atelier", cat:"convertible", price:"19,800", kind:"Snooker &amp; dining · solid hardwood", img:"assets-collection/t-monaco.png", href:"#inquire"},
  {name:"Topázio Imperial", band:"atelier", cat:"billiards", price:"18,600", kind:"Billiards · fluted twin pedestal", img:"assets-collection/t-elipse.jpg", href:"#inquire"},
  {name:"Rubelita", band:"atelier", cat:"billiards", price:"17,200", kind:"Billiards · floating walnut frame", img:"assets-collection/t-gabe.png", href:"#inquire"},
  {name:"Ametrino", band:"atelier", cat:"convertible", price:"16,400", kind:"Snooker &amp; dining · solid timber", img:"assets-collection/t-master.jpg", fit:"photo", href:"#inquire"},

  /* ---- SIGNATURE ---- */
  {name:"Citrino", band:"signature", cat:"convertible", price:"15,000", kind:"Convertible · glass-edge dining top", img:"assets-collection/citrino.jpg", tag:"Convertible", href:"#inquire-2"},
  {name:"Heliodoro", band:"signature", cat:"billiards", price:"14,200", kind:"Billiards · tapered satin-steel legs", img:"assets-collection/ambar.jpg", href:"#inquire-2"},
  {name:"Opala", band:"signature", cat:"billiards", price:"13,600", kind:"Billiards · folded Z-form base", img:"assets-collection/opal.jpg", href:"#inquire-2"},
  {name:"Esmeralda", band:"signature", cat:"billiards", price:"13,200", kind:"Billiards · faceted walnut plinth", img:"assets-collection/t-vertice.jpg", href:"#inquire-2"},
  {name:"Kunzita", band:"signature", cat:"billiards", price:"12,800", kind:"Billiards · in residence", img:"assets-collection/t-tenro.jpg", fit:"photo", href:"#inquire-2"},
  {name:"Morganita", band:"signature", cat:"billiards", price:"12,400", kind:"Billiards · live-edge top, steel fins", img:"assets-collection/t-curve.jpg", href:"#inquire-2"},
