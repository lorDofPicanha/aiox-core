function cardHTML(m){
  var photo = m.fit==="photo" ? " photo" : "";
  var alias = m.alias ? '<span class="alias">'+m.alias+'</span>' : '';
  var tag = m.tag ? '<span class="tag">'+m.tag+'</span>' : '';
  return ''+
  '<a class="card'+photo+' reveal" href="'+m.href+'" data-cat="'+m.cat+'">'+
    '<div class="frame">'+tag+
      '<img src="'+m.img+'" alt="'+m.name+(m.alias?' — '+m.alias:'')+', '+m.kind.replace(/&amp;/g,'and').replace(/·/g,'—')+'" loading="lazy" />'+
    '</div>'+
    '<div class="label">'+
      '<h3 class="gem">'+m.name+alias+'</h3>'+
      '<span class="price"><span class="from">From</span>$'+m.price+'<span class="ccy">USD · €</span></span>'+
      '<span class="kind">'+m.kind+'</span>'+
      '<span class="seemore">See '+m.name+' <span class="arrow">&rarr;</span></span>'+
    '</div>'+
  '</a>';
}

(function build(){
  var ga=document.querySelector('[data-grid="atelier"]');
  var gs=document.querySelector('[data-grid="signature"]');
  MODELS.forEach(function(m){
    var html=cardHTML(m);
    (m.band==="atelier"?ga:gs).insertAdjacentHTML('beforeend', html);
  });

  // counts per category
  var cats=["all","billiards","pingpong","foosball","shuffleboard","convertible"];
  cats.forEach(function(c){
    var n = c==="all" ? MODELS.length : MODELS.filter(function(m){return m.cat===c}).length;
    document.querySelectorAll('[data-count="'+c+'"]').forEach(function(el){el.textContent="("+n+")"});
  });
})();

/* ---------- working filter ---------- */
(function filter(){
  var chips=document.querySelectorAll('.chip');
  var bands=document.querySelectorAll('.band');
  var divider=document.querySelector('[data-divider]');
  var empty=document.getElementById('empty');

  function apply(cat){
    var totalVisible=0;
    bands.forEach(function(band){
      var cards=band.querySelectorAll('.card');
      var shown=0;
      cards.forEach(function(card){
        var match = cat==="all" || card.getAttribute('data-cat')===cat;
        card.hidden=!match;
        if(match){shown++;totalVisible++;}
      });
      band.setAttribute('data-empty', shown===0 ? "true":"false");
    });
    // hide divider if signature band is empty
    var sigEmpty=document.querySelector('[data-band="signature"]').getAttribute('data-empty')==="true";
    var atEmpty=document.querySelector('[data-band="atelier"]').getAttribute('data-empty')==="true";
    if(divider) divider.style.display=(sigEmpty||atEmpty)?"none":"block";
    empty.classList.toggle('show', totalVisible===0);
  }

  chips.forEach(function(chip){
    chip.addEventListener('click',function(){
      chips.forEach(function(c){c.setAttribute('aria-pressed','false')});
      chip.setAttribute('aria-pressed','true');
      apply(chip.getAttribute('data-cat'));
    });
  });
})();

/* ---------- sticky bar state ---------- */
var topbar=document.getElementById('topbar');
window.addEventListener('scroll',function(){
  if(window.scrollY>40){topbar.classList.add('scrolled')}else{topbar.classList.remove('scrolled')}
},{passive:true});

/* ---------- reveal on scroll ---------- */
if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}});
  },{threshold:.08,rootMargin:'0px 0px -6% 0px'});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});
}else{
  document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('in')});
}
</script>
</body>
</html>
