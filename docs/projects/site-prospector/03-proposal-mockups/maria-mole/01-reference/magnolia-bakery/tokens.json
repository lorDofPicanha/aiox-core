      "padding": "20px",
      "font_size": "70px",
      "text": "#888",
      "bg": "#ffffff",
      "border": "#cccccc",
      "radius": "2px",
      "shadow": "0 2px 1px -1px rgba(0, 0, 0, 0.2), 0 1px 1px 0 rgba(0, 0, 0, 0.14), 0 1px 3px 0 rgba(0, 0, 0, 0.12)"
    },
    "input-text": {
      "bg": "#ffffff",
      "text": "#00211a",
      "border": "#00211a",
      "radius": "2px",
      "padding": "0px 12px 10px",
      "focus_border": "#00211a"
    },
    "badge-default": {
      "bg": "#bae8d4",
      "text": "#ffffff",
      "border": "transparent",
      "radius": "0px",
      "padding": "0px 6px 0px 12px",
      "font": "10px Libre Franklin weight 700 uppercase"
    },
    "nav-header": {
      "bg": "#ffffff",
      "text": "#00211a",
      "border_bottom": "#cccccc",
      "backdrop_filter": "blur(100px)",
      "height": "80px"
    },
    "button": {
      "transition": "all .2s ease-in-out",
      "font_size": "12px",
      "transform": "translateX(-50%)",
      "cursor": "pointer",
      "text": "#fff",
      "radius": "50%",
      "font_weight": "700",
      "bg": "var(--shopify-accelerated-checkout-skeleton-background-color, #dedede)",
      "outline": "0",
      "shadow": "none",
      "states": {
        "focus": {
          "text": "#fff",
          "shadow": "0 0 0 5px #19f",
          "opacity": "1",
          "cursor": "pointer",
          "outline_color": "transparent",
          "outline": "none"
        },
        "hover": {
          "text": "var(--link-color-hover, #00211a)",
          "opacity": ".38",
          "cursor": "pointer",
          "bg": "#136f99"
        },
        "active": {
          "opacity": ".6"
        },
        "disabled": {
          "opacity": ".3",
          "cursor": "auto"
        }
      },
      "variants": {
        "secondary": {
          "text": "var(--secondary-button-color-hover, #4d2a05)",
          "opacity": ".38"
        },
        "disabled": {
          "opacity": ".7",
          "cursor": "not-allowed"
        },
        "Button": {
          "font_weight": "var(--p-font-weight, 400)",
          "font_size": "var(--p-font-size, 18px)",
          "text": "var(--p-color, #00211a)"
        },
        "no-filters": {
          "text": "var(--input-color-disabled, #888)"
        },
        "open": {
          "transform": "rotate(90deg)"
        },
        "button-container": {
          "padding": "0 60px 0 20px"
        },
        "button-container--component": {
          "font_weight": "700"
        },
        "green": {
          "bg": "#00211a"
        },
        "blue": {
          "bg": "#050e3c"
        },
        "yellow": {
          "bg": "#451f13"
        },
        "red": {
          "bg": "#581b28"
        },
        "purple": {
          "bg": "#43234c"
        },
        "light-purple": {
          "bg": "#e7cbef"
        },
        "cart-open": {
          "opacity": "1"
        },
        "on-image": {
          "text": "var(--image-button-color-hover, #000000)"
        },
        "primary-green-alt": {
          "text": "#fff"
        },
        "primary-light-green-alt": {
          "text": "#fff"
        },
        "primary-mothers-red": {
          "text": "#fff"
        },
        "secondary-green-alt": {
          "text": "var(--button-rich-accent-color, #00211a)"
        },
        "secondary-light-green-alt": {
          "text": "var(--button-rich-accent-color, #00211a)"
        },
        "secondary-mothers-red": {
          "text": "#fff"
        },
        "special": {
          "bg": "#444",
          "text": "#fff"
        },
        "seasonal": {
          "font_weight": "700"
        }
      }
    },
    "input": {
      "font_size": "16px",
      "outline": "0",
      "transform": "translateY(-50%)",
      "cursor": "default",
      "radius": "var(--input-border-radius, 2px)",
      "bg": "var(--input-background-disabled, #ddd)",
      "transition": "opacity .3s .1s,transform .2s .1s",
      "text": "var(--label-color-active, #00211a)",
      "font_weight": "var(--input-font-weight, 400)",
      "states": {
        "checked": {
          "bg": "var(--checkbox-background, #bae8d4)"
        },
        "focus": {
          "opacity": ".12",
          "outline": "5px solid #00211a",
          "outline_offset": "5px"
        },
        "hover": {
          "opacity": ".04"
        },
        "active": {
          "opacity": "1",
          "transition": "transform 0s,opacity 0s"
        },
        "disabled": {
          "text": "#000",
          "cursor": "default"
        }
      },
      "variants": {
        "visibleFocus": {
          "outline": "5px solid #00211a",
          "outline_offset": "5px"
        },
        "material-filled": {
          "padding": "0 var(--input-horizontal-padding, 12px) 10px",
          "font_weight": "var(--input-font-weight, 400)",
          "font_size": "var(--input-font-size, 16px)",
          "text": "var(--input-color, #00211a)",
          "outline": "0",
          "transition": "border-color .25s ease"
        },
        "material-outlined": {
          "radius": "var(--input-border-radius, 2px)",
          "padding": "14px var(--input-horizontal-padding, 12px)",
          "font_weight": "var(--input-font-weight, 400)",
          "font_size": "var(--input-font-size, 16px)",
          "text": "var(--input-color, #00211a)",
          "outline": "0",
          "transition": "border-color .25s ease"
        },
        "error": {
          "text": "var(--input-color, #00211a)",
          "bg": "var(--error-background, #fff)"
        }
      }
    },
    "badge": {
      "padding": "0 6px 0 12px",
      "font_weight": "700",
      "font_size": "10px",
      "text": "var(--primary-button-color, #fff)",
      "transform": "translate3d(.5px,0,0)",
      "bg": "#bae8d4",
      "variants": {
        "bottom": {
          "padding": "10px 20px 20px",
          "font_weight": "var(--h8-font-weight, 400)",
          "font_size": "var(--h8-font-size, 14px)"
        },
        "Tile": {
          "radius": "50%",
          "padding": "0 10px",
          "font_size": ".8em",
          "text": "var(--badge-color, #afd9e9)"
        }
      }
    },
    "link": {
      "shadow": "0 0 0 1px transparent",
      "text": "var(--mobile-menu-tier1-link-color)",
      "font_weight": "700",
      "font_size": "var(--mobile-menu-tier1-font-size)",
      "bg": "transparent",
      "cursor": "pointer",
      "transition": "all .2s ease-in-out",
      "radius": "var(--button-border-radius, 20px)",
      "states": {
        "focus": {
          "text": "#fff",
          "padding": "10px",
          "bg": "var(--body-background, #fff)",
          "transition": "none"
        },
        "hover": {
          "text": "rgba(0,33,26,.53)",
          "opacity": ".9"
        },
        "active": {
          "text": "var(--footer-menu-link-color)",
          "cursor": "pointer",
          "transition": "color .25s ease"
        },
        "disabled": {
          "opacity": ".3"
        }
      },
      "variants": {
        "secondary": {
          "text": "var(--secondary-button-color-hover, #4d2a05)"
        },
        "on-image": {
          "text": "var(--image-button-color-hover, #000000)"
        },
        "nested": {
          "padding": "15px"
        },
        "visibleFocus": {
          "text": "rgba(var(--color-text-dark, #00211a),.5)"
        },
        "disabled": {
          "opacity": ".3"
        },
        "primary-green-alt": {
          "text": "#fff"
        },
        "primary-light-green-alt": {
          "text": "#fff"
        },
        "primary-mothers-red": {
          "text": "#fff"
        },
        "secondary-green-alt": {
          "text": "var(--button-rich-accent-color, #00211a)"
        },
        "secondary-light-green-alt": {
          "text": "var(--button-rich-accent-color, #00211a)"
        },
        "secondary-mothers-red": {
          "text": "#fff"
        },
        "tier2": {
          "font_weight": "700",
          "font_size": "16px",
          "text": "var(--color-text-dark, #00211a)"
        }
      }
    },
    "nav": {
      "opacity": ".5",
      "radius": "25px",
      "bg": "#fff",
      "states": {
        "hover": {
          "cursor": "pointer"
        }
      },
      "variants": {
        "desktop": {
          "font_size": "15px",
          "cursor": "pointer"
        }
      }
    },
    "tab": {
      "padding": "10px",
      "opacity": ".5",
      "text": "#000",
      "font_weight": "700"
    },
    "alert": {
      "transition": "all .25s ease",
      "radius": "8px",
      "font_size": "14px",
      "font_weight": "700",
      "text": "#fff",
      "bg": "#030303",
      "opacity": ".4",
      "cursor": "pointer"
    },
    "table": {
      "font_size": "16px"
    },
    "tooltip": {
      "radius": "50%",
      "font_size": "9px",
      "cursor": "pointer"
    },
    "modal": {
      "radius": "10px",
      "bg": "#000",
      "transform": "translate(0)",
      "transition": "all .8s cubic-bezier(.215,.61,.355,1)",
      "padding": "20px",
      "text": "#f45b4f",
      "font_size": "24px",
      "font_weight": "700",
      "variants": {
        "overlay": {
          "transition": "all .4s cubic-bezier(.215,.61,.355,1)"
        },
        "container": {
          "padding": "90px",
          "text": "#00211a",
          "transform": "translate(100%)",
          "transition": "all .8s cubic-bezier(.215,.61,.355,1)",
          "font_size": "24px",
          "cursor": "pointer"
        },
        "open": {
          "opacity": "1",
          "transition": "opacity .5s ease,height .5s ease"
        }
      }
    },
    "label": {
      "font_weight": "400",
      "cursor": "pointer",
      "font_size": "12px",
      "text": "var(--placeholder-color, #451f13)",
      "variants": {
        "1": {
          "font_weight": "400",
          "font_size": "14px"
        },
        "2": {
          "font_weight": "700",
          "font_size": "12px"
        },
        "desktop": {
          "text": "var(--text-color, #00211a)"
        },
        "mobile": {
          "padding": "10px",
          "font_size": "14px"
        }
      }
    },
    "error_text": {
      "padding": "30px 0",
      "font_weight": "500",
      "text": "red"
    }
  }
}