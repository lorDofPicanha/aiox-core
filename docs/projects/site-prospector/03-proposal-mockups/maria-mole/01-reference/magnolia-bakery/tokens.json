    "button-primary": {
      "bg": "#00211a",
      "text": "#bae8d4",
      "border": "#00211a",
      "radius": "20px",
      "padding": "0px 55px",
      "font": "18px Ambit weight 400 uppercase",
      "hover_bg": "#bae8d4",
      "hover_text": "#00211a"
    },
    "button-primary-hover": {
      "bg": "#bae8d4",
      "text": "#00211a",
      "border": "#bae8d4",
      "radius": "20px",
      "padding": "0px 55px",
      "font": "18px Ambit weight 400 uppercase"
    },
    "button-secondary": {
      "bg": "#c4dad1",
      "text": "#4d2a05",
      "border": "#c4dad1",
      "radius": "20px",
      "padding": "0px 55px",
      "font": "18px Ambit weight 400 uppercase",
      "hover_bg": "#dbeae9"
    },
    "button-ghost": {
      "bg": "transparent",
      "text": "#4d2a05",
      "border": "#ffffff",
      "radius": "20px",
      "padding": "0px 55px",
      "font": "18px Ambit weight 400 uppercase",
      "hover_text": "#000000"
    },
