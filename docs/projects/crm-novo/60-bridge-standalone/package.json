{
  "name": "@crm-novo/bridge-standalone",
  "version": "0.1.0",
  "private": true,
  "description": "Meta CAPI + Google Ads offline conversion bridge — Week 0 standalone",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --turbo & npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "env:smoke": "tsx scripts/bridge-env-smoke.ts",
    "live:smoke": "tsx scripts/bridge-live-smoke.ts",
    "security:smoke": "tsx scripts/bridge-security-smoke.ts",
    "gate:0": "tsx scripts/gate-0.ts",
    "test:event": "tsx scripts/test-event.ts",
    "dlq:replay": "tsx scripts/dlq-replay.ts",
    "google:oauth": "tsx scripts/google-oauth.ts",
    "google:probe": "tsx scripts/google-route-probe.ts",
    "db:migrate": "psql $SUPABASE_DB_URL -f db/0001_initial.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "google-ads-api": "^17.0.0",
    "inngest": "^3.30.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
