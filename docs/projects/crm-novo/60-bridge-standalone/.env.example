# ──────────────────────────────────────────────────────────────
# Bridge Standalone — Environment Variables Template
# ──────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.

# ─── Supabase ──────────────────────────────────────────────
# Project: criar em supabase.com region sa-east-1
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ─── Meta CAPI ──────────────────────────────────────────────
# Source: Business Manager → Events Manager → Settings → Conversions API
META_PIXEL_ID=YOUR_PIXEL_ID
META_ACCESS_TOKEN=YOUR_SYSTEM_USER_TOKEN
# Test event code: enquanto estiver desenvolvendo. Deixa vazio em prod.
META_TEST_EVENT_CODE=TEST12345
META_API_VERSION=v21.0

# ─── Google Ads API ────────────────────────────────────────
# Developer token: apply em ads.google.com/aw/apicenter (24h aprovação)
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_DEV_TOKEN
# OAuth: criar em console.cloud.google.com → API → OAuth client (web)
GOOGLE_ADS_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxxx
# Refresh token: gerar 1× via pnpm google:oauth (test mode = 7d expiry)
GOOGLE_ADS_REFRESH_TOKEN=1//xxxxxx
# Customer IDs: sem hifens (1234567890 não 123-456-7890)
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Login customer: MCC ID se aplicar (Manager Account). Vazio se single account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Conversion action resource name (formato: customers/X/conversionActions/Y)
GOOGLE_ADS_CONVERSION_ACTION_LEAD_QUALIFIED=customers/1234567890/conversionActions/AAAAAAAAAAA
GOOGLE_ADS_CONVERSION_ACTION_DEAL_WON=customers/1234567890/conversionActions/BBBBBBBBBBB
# Set true only if this developer token successfully uploaded offline/enhanced lead conversions before 2026-06-15.
# Otherwise Google docs require Data Manager API for new integrations.
GOOGLE_ADS_UPLOAD_CLICK_PRE_2026_06_15=false

# ─── Google Data Manager API fallback ─────────────────────────────────────────
# Used when GOOGLE_ADS_UPLOAD_CLICK_PRE_2026_06_15 is false/unknown.
# Access token is for manual live probes only; production should use a proper OAuth flow/secret.
DATA_MANAGER_ACCESS_TOKEN=
DATA_MANAGER_OPERATING_ACCOUNT_ID=1234567890
DATA_MANAGER_LOGIN_ACCOUNT_ID=1234567890
DATA_MANAGER_CONVERSION_ACTION_ID=AAAAAAAAAAA

# ─── Inngest ───────────────────────────────────────────────
# Generate em app.inngest.com → Settings → Keys
INNGEST_EVENT_KEY=xxxxx
INNGEST_SIGNING_KEY=signkey-xxxxx
# In dev local: deixa vazio (inngest-cli dev cria signing key sintético)

# ─── Manual trigger endpoint ──────────────────────────────
# Bearer token simples Week 0. Substituir por Supabase JWT em Sprint 1.
MANUAL_TRIGGER_TOKEN=$(openssl rand -hex 32)

# ─── Misc ──────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
