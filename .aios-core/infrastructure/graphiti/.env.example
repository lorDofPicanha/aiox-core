# Required by Graphiti for LLM inference and embeddings.
OPENAI_API_KEY=

# AIOS Graphiti sync backend.
# Recommended local default: kuzu (embedded, no Docker/Java).
AIOS_GRAPHITI_BACKEND=kuzu
KUZU_DB_PATH=D:\AIOS\.aios-core\data\memory\graphiti-kuzu

# FalkorDB local defaults, if you choose FalkorDB instead of Kuzu.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Alternative Neo4j defaults.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
