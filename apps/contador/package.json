{
  "name": "contador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3008",
    "prebuild": "npm run banlist:g6",
    "build": "next build",
    "start": "next start -p 3008",
    "typecheck": "tsc --noEmit",
    "test:ecac": "node app/ecac/saude-fiscal-model.test.mjs",
    "test:divida": "node app/ecac/divida-ativa-model.test.mjs",
    "test:guias": "node app/ecac/guias/guias-model.test.mjs",
    "test:adapters": "node app/ecac/adapters/adapters.test.mjs",
    "test:ecac:all": "node app/ecac/saude-fiscal-model.test.mjs && node app/ecac/divida-ativa-model.test.mjs && node app/ecac/guias/guias-model.test.mjs && node app/ecac/adapters/adapters.test.mjs",
    "test:health": "node app/saude-carteira/health-score-model.test.mjs && node app/saude-carteira/health-score-reconcile.test.mjs",
    "test:transacao": "node app/transacao/transacao-model.test.mjs",
    "banlist:g6": "node scripts/banlist-g6.mjs",
    "banlist:g6:self-test": "node scripts/banlist-g6.mjs --self-test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@synkra/contador-api-client": "file:../../packages/contador-api-client",
    "@synkra/contador-motor-fiscal": "file:../../packages/contador-motor-fiscal",
    "@synkra/contador-parser": "file:../../packages/contador-parser",
    "@synkra/contador-nfse-client": "file:../../packages/contador-nfse-client",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
