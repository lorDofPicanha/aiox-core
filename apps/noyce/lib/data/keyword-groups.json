{
  "version": 1,
  "note": "Grupos semeados a partir dos TERMOS REAIS que ocorrem nos objetos do discovery-snapshot (PNCP, raio 500 km). Nenhum termo inventado: cada palavra-chave foi verificada com o painel de teste antes de entrar aqui. Indesejadas foram calibradas para não derrubar obra real — ver tests/noyce-keywords.test.mjs.",
  "groups": [
    {
      "id": "obras-civis",
      "name": "Obras civis",
      "note": "O tronco: execução de obra e engenharia. É o grupo que mais captura e o que mais precisa de veto.",
      "rules": [
        {
          "id": "oc-construcao",
          "term": "construção",
          "complementares": [],
          "indesejadas": ["material de construção", "aquisição de materiais", "aquisição de insumos"],
          "complementarMode": "todas",
          "enabled": true,
          "note": "Sem os vetos, 41 compras de material de construção entram como se fossem obra."
        },
        {
          "id": "oc-engenharia",
          "term": "engenharia",
