# Noyce — variáveis de ambiente (copie para .env.local e preencha)

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# OpenAI (provider atual): com a chave definida, o squad usa OpenAI.
# Mapeamento por tier: triagem (Faro, "haiku") → gpt-5-mini · análise (Prisma/Forja,
# "opus"/"sonnet") → gpt-5.5. Família gpt-5.x = raciocínio (max_completion_tokens + reasoning_effort).
OPENAI_API_KEY=
# OPENAI_MODEL=             # opcional: força UM modelo p/ tudo (ignora o mapeamento)
# OPENAI_MODEL_TRIAGE=gpt-5-mini    # opcional: override só da triagem
# OPENAI_MODEL_ANALYSIS=gpt-5.5     # opcional: override só da análise
# LLM_PROVIDER=openai       # opcional: força o provider (openai|claude)

# Claude (provider alternativo/histórico): usado quando OPENAI_API_KEY não está definida.
# Requer: npm i @anthropic-ai/sdk
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Overrides de modelo por feature (opcionais)
# -----------------------------------------------------------------------------
# DOC_CHAT_MODEL=           # modelo do chat de documentos (/api/doc-chat); default = tier de análise
# WIN_INTEL_MODEL=          # modelo do win-intel (/api/win-intel); default = tier de análise

# -----------------------------------------------------------------------------
# Piloto privado (obrigatório em produção)
# -----------------------------------------------------------------------------
NOYCE_ACCESS_USER=
NOYCE_ACCESS_PASSWORD=
