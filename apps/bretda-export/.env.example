# Ad tracking. Every value is optional — a missing id simply means that
# platform's script never loads. Set these in Vercel (Project → Settings →
# Environment Variables) before spending on media, otherwise the campaigns
# optimise blind.

# Meta (Facebook/Instagram) pixel id — Events Manager → Data Sources
NEXT_PUBLIC_FB_PIXEL_ID=

# GA4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads conversion id, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label of the "Inquiry" action, the part after the slash in the
# snippet Google gives you (AW-123456789/AbC-D_efGh)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Canonical origin, used for og:url and canonical tags. Change this the moment
# a custom domain replaces the vercel.app host.
NEXT_PUBLIC_SITE_URL=https://bretda-export.vercel.app
